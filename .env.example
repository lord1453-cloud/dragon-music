# ============================================
# 🐲 Ejderha Müzik Botu - Ortam Değişkenleri
# ============================================
# Bu dosyayı ".env" olarak kopyalayıp gerçek değerlerinizi girin.
# cp .env.example .env

# Telegram Bot Token (@BotFather'dan alınır)
BOT_TOKEN=1234567890:ABCdefGHIjklMNOpqrsTUVwxyz

# Telegram API bilgileri (https://my.telegram.org adresinden alınır)
API_ID=12345678
API_HASH=abcdef1234567890abcdef1234567890

# Pyrogram Session String (Userbot için gerekli)
# Sesli sohbete katılmak için bir kullanıcı hesabının session string'i gereklidir.
# Üretmek için: python -c "from pyrogram import Client; Client('session', api_id=API_ID, api_hash='API_HASH').start()"
SESSION_STRING=BQA...uzun_session_string...

# İndirme kalitesi (varsayılan: 320)
AUDIO_BITRATE=320

# Log seviyesi (DEBUG, INFO, WARNING, ERROR)
LOG_LEVEL=INFO

# Telegram Log Grubu (Botun başlatma/hata/kapatma loglarını göndereceği grup)
# Grup ID'sini öğrenmek için gruba @userinfobot ekleyebilirsiniz
LOG_GROUP_ID=-100123456789

# YouTube Cookies Dosya Yolu (403 / "Sign in to confirm you're not a bot" engelini aşmak için)
# Proje ana dizinindeki cookies.txt dosyasını otomatik algılar veya buradan özel yol verebilirsiniz.
COOKIES_FILE_PATH=cookies.txt

# Spotify API Bilgileri (https://developer.spotify.com/dashboard adresinden alınır)
# Belirtilmezse fallback mekanizması ile yine de Spotify linkleri çözümlenir.
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=

